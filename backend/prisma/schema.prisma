// ============================================================================
//  Sulton School — ERP & LMS  |  Prisma Schema (yagona haqiqat manbai)
//  DB: PostgreSQL 16  |  ORM: Prisma
//  Eslatma: bu sxema docs/DATABASE.md hujjatining kod ko'rinishidir.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE        // o'qiyapti
  GRADUATED     // bitirgan
  EXPELLED      // chetlatilgan
  ARCHIVED      // arxiv
}

enum LeadActivityType {
  CALL          // qo'ng'iroq
  NOTE          // izoh
  REMINDER      // eslatma
  MEETING       // uchrashuv
}

enum VisitStatus {
  PLANNED       // rejadagi tashrif
  ARRIVED       // keldi (real tashrif)
  NO_SHOW       // kelmadi
  CANCELLED     // bekor qilindi
}

enum ContractStatus {
  DRAFT
  ACTIVE // Faol
  COMPLETED
  CANCELLED
  SUSPENDED // Band
  TEMP_SUSPENDED // Vaqtincha band
  LEFT // Ketdi-aniqlashga
  OTHER // Boshqa
}

enum ContractType {
  MONTHLY // Oylik
  YEARLY // Yillik
}

enum InstallmentStatus {
  PENDING       // kutilmoqda
  PARTIAL       // qisman to'langan
  PAID          // to'langan
  OVERDUE       // muddati o'tgan
}

enum DiscountType {
  PERCENT
  FIXED
}

enum TransactionType {
  INCOME        // kirim
  EXPENSE       // chiqim
  TRANSFER      // ichki o'tkazma
  INVESTMENT    // investitsiya
}

enum SalaryType {
  MONTHLY       // oylik stavka
  HOURLY        // soatbay
  PER_LESSON    // darsbay
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum GradeType {
  DAILY         // kunlik
  HOMEWORK      // uyga vazifa
  QUARTER       // chorak
  SEMESTER      // yarim yillik
  YEAR          // yillik
  EXAM          // imtihon (nazorat)
}

enum AttendanceStatus {
  PRESENT       // bor
  ABSENT        // yo'q (sababsiz)
  LATE          // kechikkan
  EXCUSED       // sababli
}

enum HomeworkSubmissionStatus {
  ASSIGNED      // berilgan
  SUBMITTED     // topshirilgan
  CHECKED       // tekshirilgan
  LATE          // kech topshirilgan
  MISSING       // topshirilmagan
}

enum BehaviorType {
  POSITIVE
  NEGATIVE
}

enum NotificationChannel {
  TELEGRAM
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// ============================================================================
//  AUTH & RBAC  (rol asosida kirish — 5 xodim roli + o'quvchi + ota-ona)
// ============================================================================

model User {
  id        String     @id @default(uuid())
  fullName  String
  email     String?    @unique
  phone     String     @unique
  password  String
  avatar    String?
  status    UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Ustoz uchun o'qitadigan fan (ixtiyoriy)
  subjectId String?
  subject   Subject? @relation("TeacherSubject", fields: [subjectId], references: [id])

  // bog'liqliklar
  employee        Employee?
  studentProfile  Student?         @relation("StudentUser")
  guardianProfile Guardian?        @relation("GuardianUser")
  assignedLeads   Lead[]           @relation("LeadManager")
  leadActivities  LeadActivity[]
  taughtClasses   ClassTeacher[]
  givenGrades     Grade[]          @relation("GradeTeacher")
  givenHomeworks  Homework[]       @relation("HomeworkTeacher")
  behaviorRecords BehaviorRecord[] @relation("BehaviorAuthor")
  notifications   Notification[]
  telegramLink    TelegramLink?
  auditLogs       AuditLog[]
  debtorContacts  DebtorContact[]  @relation("DebtorContactAuthor")
  markedAttendances Attendance[]   @relation("AttendanceMarker")
  employeeNotes   EmployeeNote[]   @relation("EmployeeNoteAuthor")
  flowAccounts    FlowAccount[]
  cpEntriesCreated   CounterpartyEntry[] @relation("CpEntryCreatedBy")
  cpEntriesUpdated   CounterpartyEntry[] @relation("CpEntryUpdatedBy")
  cpEntriesConfirmed CounterpartyEntry[] @relation("CpEntryConfirmedBy")
  itCreated          InternalTransfer[] @relation("ITCreatedBy")
  itUpdated          InternalTransfer[] @relation("ITUpdatedBy")
  itConfirmed        InternalTransfer[] @relation("ITConfirmedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@map("users")
}

/// Qarzdor bilan aloqa jurnali (qo'ng'iroq, izoh) — qarzdorlik sahifasida
model DebtorContact {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("DebtorContactAuthor", fields: [authorId], references: [id])
  type      String   @default("OTHER") // CALL, TELEGRAM, SMS, MEETING, OTHER
  note      String
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@map("debtor_contacts")
}

model Role {
  id          String           @id @default(uuid())
  name        String           // "Administrator", "Sotuv menejeri", ...
  slug        String           @unique // admin, sales, coordinator, teacher, curator, student, guardian
  description String?
  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid())
  name  String           // "students.create", "finance.view", ...
  slug  String           @unique
  group String           // "students", "finance", "lms", ...
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================================
//  STUDENTS & GUARDIANS  (O'quvchi kabineti)
// ============================================================================

model Student {
  id            String        @id @default(uuid())
  userId        String?       @unique
  user          User?         @relation("StudentUser", fields: [userId], references: [id])
  firstName     String
  lastName      String
  middleName    String?
  photo         String?
  birthDate     DateTime?
  gender        Gender?
  address       String?
  documentType   String? // Hujjat turi (Tug'ilganlik guvohnomasi, ...)
  documentSeries String? // Hujjat seriya / raqami
  prevSchoolType String? // Oldingi maktab turi (Davlat/Xususiy)
  prevSchoolName String? // Oldingi maktab nomi
  admissionDate DateTime?
  status        StudentStatus @default(ACTIVE)

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  guardians   StudentGuardian[]
  documents   StudentDocument[]
  contracts   Contract[]
  payments    Payment[]
  grades      Grade[]
  attendances Attendance[]
  submissions HomeworkSubmission[]
  behavior    BehaviorRecord[]
  debtorContacts DebtorContact[]
  lead        Lead?                @relation("LeadStudent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([status])
  @@map("students")
}

model Guardian {
  id       String  @id @default(uuid())
  userId   String? @unique
  user     User?   @relation("GuardianUser", fields: [userId], references: [id])
  fullName String
  phone    String
  relation String? // ota, ona, vasiy
  passport String?
  telegramUsername String?
  students StudentGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guardians")
}

model StudentGuardian {
  studentId  String
  guardianId String
  isPrimary  Boolean  @default(false)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model StudentDocument {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String   // metrika, ariza, surat, ...
  filePath  String
  fileName  String
  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("student_documents")
}

// ============================================================================
//  CRM — QABUL OYNASI  (Lead funnel)
// ============================================================================

model LeadStage {
  id    String @id @default(uuid())
  name  String // Yangi, Bog'lanildi, Sinov darsi, Shartnoma, ...
  order Int
  color String?
  leads Lead[]

  @@map("lead_stages")
}

model Lead {
  id           String  @id @default(uuid())
  fullName     String // talaba (o'quvchi) ismi
  phone        String // vasiy telefoni
  guardianName String? // vasiy (ota-ona) ismi
  igUsername   String? // Instagram @username (ko'rsatish uchun)
  source       String? // Instagram, tavsiya, reklama, sayt, ...
  externalId   String? @unique // sayt (Supabase) / ig:<id> — takror oldini oladi
  childAge     Int?
  note         String?

  // Tashrif (qabul) ma'lumotlari
  scheduledAt  DateTime? // belgilangan tashrif vaqti
  filial       String? // Farg'ona, Lokomotiv, ...
  gradeLevel   Int? // qaysi sinfga (0..11)
  whoComes     String? // "Ota va farzand", "Ona", ...
  crmUpdatedAt DateTime? // CRM dan oxirgi yangilanish
  visitStatus  VisitStatus @default(PLANNED) // rejadagi/real tashrif
  visitedAt    DateTime? // haqiqatda kelgan vaqt

  // Qabul (admission) ma'lumotlari
  academicYear   String?
  classId        String?
  class          Class?        @relation(fields: [classId], references: [id])
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  psychologistId String?
  psychologist   Psychologist? @relation(fields: [psychologistId], references: [id])
  tags           String[]

  // Test / psixolog / ota-ona bahosi (qabul jarayoni)
  testType               String? // Test turlari
  testLogicPct           Int? // Mantiq (%) — kamida 30
  psychologistConclusion String? // Psixolog xulosasi (Qabul qilish mumkin, ...)
  motherStatus           String? // Onasi statusi (Ma'qul, ...)
  fatherStatus           String? // Otasi statusi (Ma'qul, ...)
  demoStartDate          DateTime? // Demo boshlanish sanasi (ixtiyoriy)

  stageId   String
  stage     LeadStage @relation(fields: [stageId], references: [id])
  managerId String?
  manager   User?     @relation("LeadManager", fields: [managerId], references: [id])

  // konversiya bo'lsa — o'quvchiga aylanadi
  studentId  String?  @unique
  student    Student? @relation("LeadStudent", fields: [studentId], references: [id])
  convertedAt DateTime?

  activities LeadActivity[]
  messages   LeadMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
  @@index([managerId])
  @@map("leads")
}

// Instagram Direct / boshqa suhbat xabarlari (lead ichida ko'rsatiladi)
model LeadMessage {
  id         String   @id @default(uuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction  String // 'IN' (mijozdan) | 'OUT' (bizdan)
  text       String
  externalId String?  @unique // Meta message id (mid) — takror oldini oladi (webhook + sync)
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("lead_messages")
}

model LeadActivity {
  id      String           @id @default(uuid())
  leadId  String
  lead    Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?           @relation(fields: [authorId], references: [id])
  type    LeadActivityType
  note    String?
  dueAt   DateTime?        // eslatma vaqti
  doneAt  DateTime?
  createdAt DateTime       @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

// Filial (bo'lim)
model Branch {
  id        String    @id @default(uuid())
  name      String
  students  Student[]
  classes   Class[]
  leads     Lead[]
  suppliers Supplier[]
  expenses  Expense[]
  counterparties Counterparty[]
  counterpartyLinks CounterpartyBranch[]
  flowAccounts FlowAccount[]
  internalTransfers InternalTransfer[]
  employees Employee[]
  employeeLinks EmployeeBranch[]
  employmentContracts EmploymentContract[]
  salaryPayments SalaryPayment[]
  createdAt DateTime  @default(now())

  @@map("branches")
}

// Psixolog (qabul suhbati uchun)
model Psychologist {
  id        String   @id @default(uuid())
  fullName  String
  leads     Lead[]
  createdAt DateTime @default(now())

  @@map("psychologists")
}

// O'quv yili (Sozlamalarда boshqariladi)
model AcademicYear {
  id       String  @id @default(uuid())
  name     String  @unique // "2025-2026"
  isActive Boolean @default(true)

  @@map("academic_years")
}

// Qabul rejasi — sinf/filial bo'yicha rejalashtirilgan o'quvchilar soni
model AdmissionPlan {
  id           String   @id @default(uuid())
  academicYear String // "2025-2026"
  filial       String? // null => barcha filiallar
  gradeLevel   Int // 0..11
  plannedCount Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admission_plans")
}

// ============================================================================
//  CLASSES, SUBJECTS & SCHEDULE  (Sinflar va guruhlar)
// ============================================================================

model Class {
  id           String  @id @default(uuid())
  name         String  // "5-A", "10-B"
  gradeLevel   Int     // 1..11
  academicYear String  // "2025-2026"
  capacity     Int     @default(30)
  room         String?
  language     String? // "O'zbek", "Rus", "Ingliz"
  status       String  @default("Faol") // "Faol", "Nofaol", "Arxiv"
  telegramGroup String? // Telegram guruh havolasi (ixtiyoriy)
  branchId     String?
  branch       Branch? @relation(fields: [branchId], references: [id])

  students   Student[]
  teachers   ClassTeacher[]
  schedules  Schedule[]
  attendances Attendance[]
  homeworks  Homework[]
  admissions Lead[]
  norms      SubjectNorm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("classes")
}

model ClassTeacher {
  id        String  @id @default(uuid())
  classId   String
  teacherId String
  isCurator Boolean @default(false) // true => kurator, false => fan o'qituvchisi
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   User    @relation(fields: [teacherId], references: [id])

  @@unique([classId, teacherId])
  @@map("class_teachers")
}

model Subject {
  id        String     @id @default(uuid())
  name      String
  code      String?    @unique
  schedules Schedule[]
  grades    Grade[]
  homeworks Homework[]
  norms     SubjectNorm[]
  teachers  User[]        @relation("TeacherSubject")

  @@map("subjects")
}

/// Fan bo'yicha haftalik soat normasi (reja) — sinfga nisbatan
model SubjectNorm {
  id          String  @id @default(uuid())
  classId     String
  subjectId   String
  weeklyHours Int     @default(0)
  class       Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@map("subject_norms")
}

model Schedule {
  id        String  @id @default(uuid())
  classId   String
  subjectId String
  teacherId String?
  weekday   Int     // 1=Dushanba ... 7=Yakshanba
  startTime String  // "08:30"
  endTime   String  // "09:15"
  room      String?
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@index([classId])
  @@map("schedules")
}

// ============================================================================
//  CONTRACTS  (Shartnoma tizimi)
// ============================================================================

model Discount {
  id        String       @id @default(uuid())
  name      String
  type      DiscountType
  value     Float
  contracts Contract[]

  @@map("discounts")
}

model Contract {
  id            String         @id @default(uuid())
  number        String         @unique // SHRT-2025-0001
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id])
  startDate     DateTime
  endDate       DateTime?
  monthlyAmount Float
  type          ContractType   @default(MONTHLY)
  discountId    String?
  discount      Discount?      @relation(fields: [discountId], references: [id])
  status        ContractStatus @default(DRAFT)
  pdfPath       String?

  installments ContractInstallment[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("contracts")
}

/// DOCX'dan yuklab olingan va ERP ichida tahrirlanadigan shartnoma shabloni.
/// html — mammoth orqali DOCX'dan aylantirilgan, {{token}} o'rin egallovchilar bilan.
model ContractTemplate {
  id        String   @id @default(uuid())
  name      String
  html      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract_templates")
}

model ContractInstallment {
  id         String            @id @default(uuid())
  contractId String
  contract   Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  dueDate    DateTime
  amount     Float
  paidAmount Float             @default(0)
  status     InstallmentStatus @default(PENDING)
  allocations PaymentAllocation[]

  @@index([contractId])
  @@index([status])
  @@map("contract_installments")
}

model Payment {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id])
  amount      Float
  method      String    // kassa turi: Naqd, Bank, Karta
  type        String?   // to'lov turi: Click, Payme, Terminal...
  cardLast4   String?   // karta oxirgi 4 raqami / RRN
  isRefund    Boolean   @default(false) // qaytarish (−) rejimi
  paidAt      DateTime  @default(now())
  note        String?
  confirmedAt DateTime? // tasdiqlangan sana (null = tasdiqlanmagan)
  createdById String?   // kim yaratdi (user id)
  updatedById String?   // kim o'zgartirdi (user id)
  updateCount Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  allocations PaymentAllocation[]

  @@index([studentId])
  @@index([contractId])
  @@index([accountId])
  @@map("payments")
}

/// To'lovning aniq oy(installment)larga taqsimlanishi (qo'lda taqsimlash uchun)
model PaymentAllocation {
  id            String              @id @default(uuid())
  paymentId     String
  payment       Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installmentId String
  installment   ContractInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amount        Float

  @@index([paymentId])
  @@index([installmentId])
  @@map("payment_allocations")
}

// ============================================================================
//  TREASURY & FINANCE  (G'azna & Moliya)
// ============================================================================

model Account {
  id              String           @id @default(uuid())
  name            String        // Asosiy kassa, Bank, ...
  balance         Float            @default(0)
  openingBalance  Float            @default(0) // boshlang'ich qoldiq (harakatlardan tashqari); balance = openingBalance + Σ(harakatlar)
  transactions          Transaction[]
  payments              Payment[]
  expensePayments       ExpensePayment[] @relation("ExpenseSomAccount")
  expenseDollarPayments ExpensePayment[] @relation("ExpenseDollarAccount")
  counterpartyEntries   CounterpartyEntry[] @relation("CpEntryAccount")

  @@map("accounts")
}

model FinanceCategory {
  id           String          @id @default(uuid())
  name         String
  type         TransactionType
  transactions Transaction[]
  expenseLines ExpenseLine[]

  @@map("finance_categories")
}

// ===== Xarajatlar (ta'minotchi hujjatlari) =====
model Supplier {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  branchId  String?
  branch    Branch?   @relation(fields: [branchId], references: [id])
  expenses  Expense[]
  createdAt DateTime  @default(now())

  @@map("suppliers")
}

model Expense {
  id           String           @id @default(uuid())
  number       Int              @default(autoincrement())
  supplierId   String
  supplier     Supplier         @relation(fields: [supplierId], references: [id])
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id])
  department   String?
  date         DateTime         @default(now())
  academicYear String?
  note         String?
  lines        ExpenseLine[]
  payments     ExpensePayment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@index([supplierId])
  @@index([branchId])
  @@map("expenses")
}

model ExpenseLine {
  id          String           @id @default(uuid())
  expenseId   String
  expense     Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    FinanceCategory? @relation(fields: [categoryId], references: [id])
  subCategory String?
  name        String
  quantity    Float            @default(1)
  price       Float            @default(0)
  note        String?
  createdAt   DateTime         @default(now())

  @@index([expenseId])
  @@map("expense_lines")
}

model ExpensePayment {
  id        String   @id @default(uuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount    Float    // so'm qismi
  method    String   // Naqd / Karta / Bank
  accountId String?
  account   Account? @relation("ExpenseSomAccount", fields: [accountId], references: [id])
  // Dollar qismi (ixtiyoriy) — so'mdagi ekvivalenti = dollarAmount * dollarRate
  dollarAmount    Float?
  dollarRate      Float?
  dollarMethod    String?
  dollarAccountId String?
  dollarAccount   Account? @relation("ExpenseDollarAccount", fields: [dollarAccountId], references: [id])
  paidAt    DateTime @default(now())
  isRefund  Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  @@index([expenseId])
  @@map("expense_payments")
}

model Transaction {
  id         String           @id @default(uuid())
  type       TransactionType
  amount     Float
  accountId  String
  account    Account          @relation(fields: [accountId], references: [id])
  categoryId String?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id])
  date       DateTime         @default(now())
  description String?
  createdAt  DateTime         @default(now())

  @@index([type])
  @@index([date])
  @@map("transactions")
}

// ============================================================================
//  HR & PAYROLL  (HR bo'limi + oylik hisob-kitob)
// ============================================================================

model Department {
  id        String     @id @default(uuid())
  name      String
  positions Position[]
  employees Employee[]

  @@map("departments")
}

model Position {
  id           String     @id @default(uuid())
  name         String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  employees    Employee[]

  @@map("positions")
}

model Employee {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id])
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  positionId   String?
  position     Position?      @relation(fields: [positionId], references: [id])
  branchId     String?
  branch       Branch?        @relation(fields: [branchId], references: [id])
  branchLinks  EmployeeBranch[]
  gender       Gender?
  cardNumber   String?
  formal       Boolean        @default(false) // rasmiy / norasmiy
  middleName   String?        // otasining ismi
  birthDate    DateTime?
  passportSeriya String?
  passportRaqam  String?
  passportBerilgan DateTime?
  passportOrgan  String?
  stir         String?
  address      String?
  mapLink      String?
  employment   String?        // bandlik
  kimIshlaydi  String?        // kim ishlaydi (Shaxsan ishlaydi...)
  hireDate     DateTime
  fireDate     DateTime?
  status       EmployeeStatus @default(ACTIVE)

  salary       Salary?
  payrollItems PayrollItem[]
  documents    EmployeeDocument[]
  contracts    EmploymentContract[]
  notes        EmployeeNote[]
  salaryPayments SalaryPayment[]
  payrollRecords PayrollRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

// Oylik hisob yozuvi (Maoshlar · Oylik hisob) — bir xodim, bir oy
model PayrollRecord {
  id           String   @id @default(uuid())
  period       String   // "2026-07"
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Hisob-kitob
  ishchiKunlar Int      @default(0)
  ishlaganKun  Int      @default(0)
  ishlaganSoat Float    @default(0)
  asosiyOylik  Float    @default(0)
  soatlikNarx  Float    @default(0)
  rasmiyHisob  Float    @default(0)
  soliqKim     String?  // O'zi to'laydi / Kompaniya
  // Qo'shimcha
  kpi          Float    @default(0)
  bonus        Float    @default(0)
  ovqatPuli    Float    @default(0)
  tatilKartaga Float    @default(0)
  tatilNaqd    Float    @default(0)
  ijara        Float    @default(0)
  transport    Float    @default(0)
  jarima       Float    @default(0)
  soliq        Float    @default(0)
  // Taqsimot
  naqd         Float    @default(0)
  karta        Float    @default(0)
  jami         Float    @default(0) // hisoblangan
  confirmed    Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([period, employeeId])
  @@index([period])
  @@map("payroll_records")
}

// Maosh to'lovi (Maoshlar · To'lovlar)
model SalaryPayment {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  kassa        String   // so'm kassa turi: Naqd | Karta | Bank
  somAmount    Float    @default(0)
  somAccountId String?
  somAccount   FlowAccount? @relation("SalarySomAccount", fields: [somAccountId], references: [id])
  dollarAmount Float?
  dollarRate   Float?
  dollarKassa  String?
  dollarAccountId String?
  dollarAccount FlowAccount? @relation("SalaryDollarAccount", fields: [dollarAccountId], references: [id])
  periodYear   Int?
  periodMonth  Int?
  note         String?
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@index([date])
  @@map("salary_payments")
}

// Mehnat shartnomasi (Maoshlar · Shartnomalar)
model EmploymentContract {
  id         String   @id @default(uuid())
  number     String   // raqam (60/2, 35/3...)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  type       String   // shartnoma turi
  employment String?  // bandlik turi
  stavka     Float?
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  status     String   @default("YARATILGAN") // YARATILGAN | OZGARTIRILGAN | BEKOR
  date2         DateTime? // tugash / o'zgartirish sanasi
  kelishSana    DateTime? // kelish sanasi (K.SANA)
  kKuni         String?
  til           String?   // shartnoma tili
  qoshimchaLavozim String?
  qoshimchaStavka  Float?
  modda         String?
  fayl1         String?
  fayl2         String?
  fayl3         String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([date])
  @@map("employment_contracts")
}

/// Xodimga izoh (istalgan lavozim/xodim sahifasidan ko'rinadi)
model EmployeeNote {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation("EmployeeNoteAuthor", fields: [authorId], references: [id])
  text       String
  createdAt  DateTime @default(now())

  @@index([employeeId, createdAt])
  @@map("employee_notes")
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String   // mehnat shartnomasi, ariza, ...
  filePath   String
  fileName   String
  createdAt  DateTime @default(now())

  @@map("employee_documents")
}

model Salary {
  id         String     @id @default(uuid())
  employeeId String     @unique
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       SalaryType
  baseRate   Float // asosiy stavka: Kunbay/Ishbay/KPI = o'zgarmas oylik, Soatbay = soat narxi
  hisobKitob String?    // Kunbay | Soatbay | Ishbay | KPI
  // Kelishuv (joriy) qo'shimcha maydonlari
  rasmiyOyligi Float?   // rasmiy (hujjatdagi, soliq uchun) oylik — Rasmiy bo'lsa
  soliqKim     String?  // Ishchi | Ish beruvchi
  startDate    DateTime? // kelishuv boshlanish sanasi
  endDate      DateTime? // kelishuv tugash sanasi (bo'sh = joriy)
  note         String?   // izoh

  @@map("salaries")
}

// Xodim ↔ Filial (ko'p-filial)
model EmployeeBranch {
  employeeId String
  branchId   String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([employeeId, branchId])
  @@index([branchId])
  @@map("employee_branches")
}

model PayrollRun {
  id        String        @id @default(uuid())
  period    String        @unique // "2026-06"
  status    PayrollStatus @default(DRAFT)
  items     PayrollItem[]
  createdAt DateTime      @default(now())

  @@map("payroll_runs")
}

model PayrollItem {
  id           String        @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id])
  base         Float
  bonus        Float         @default(0)
  penalty      Float         @default(0)
  total        Float
  status       PayrollStatus @default(DRAFT)
  paidAt       DateTime?

  @@unique([payrollRunId, employeeId])
  @@map("payroll_items")
}

// ============================================================================
//  LMS — GRADING, ATTENDANCE, HOMEWORK, BEHAVIOR
// ============================================================================

model Grade {
  id        String    @id @default(uuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   User?     @relation("GradeTeacher", fields: [teacherId], references: [id])
  value     Float
  type      GradeType @default(DAILY)
  period    String?   // "1-chorak", "2-chorak", ... (Chorak/Yillik uchun asosiy ajratuvchi)
  comment   String?
  date      DateTime  @default(now())
  createdAt DateTime  @default(now()) // qachon qo'yilgan (audit)
  updatedAt DateTime  @updatedAt

  @@index([studentId])
  @@index([subjectId])
  @@index([subjectId, type, date])
  @@index([teacherId])
  @@map("grades")
}

model Attendance {
  id         String           @id @default(uuid())
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String?
  class      Class?           @relation(fields: [classId], references: [id])
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  note       String?
  markedById String?          // kim belgilagan (audit)
  markedBy   User?            @relation("AttendanceMarker", fields: [markedById], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([date])
  @@map("attendances")
}

model Homework {
  id          String   @id @default(uuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  teacherId   String
  teacher     User     @relation("HomeworkTeacher", fields: [teacherId], references: [id])
  title       String
  type        String   @default("Uyga vazifa") // vazifa turi (HomeworkType.name)
  description String?
  attachments String[] // biriktirilgan fayllar (JSON: {n,t,d})
  dueDate     DateTime
  createdAt   DateTime @default(now())

  submissions HomeworkSubmission[]

  @@index([classId])
  @@map("homeworks")
}

/// Vazifa turlari — qayta ishlatiladigan ro'yxat (Uyga vazifa, Ijodiy ish, ...)
model HomeworkType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("homework_types")
}

model HomeworkSubmission {
  id          String                   @id @default(uuid())
  homeworkId  String
  homework    Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files       String[]
  comment     String?
  grade       Float?
  teacherNote String?
  status      HomeworkSubmissionStatus @default(ASSIGNED)
  submittedAt DateTime?

  @@unique([homeworkId, studentId])
  @@map("homework_submissions")
}

model BehaviorRecord {
  id          String       @id @default(uuid())
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?        @relation("BehaviorAuthor", fields: [authorId], references: [id])
  type        BehaviorType
  points      Int          @default(0)
  description String
  date        DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([studentId])
  @@map("behavior_records")
}

// ============================================================================
//  NOTIFICATIONS & INTEGRATIONS  (Telegram bot, SMS, E-maktab)
// ============================================================================

model Notification {
  id        String              @id @default(uuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  title     String?
  body      String
  status    NotificationStatus  @default(QUEUED)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model TelegramLink {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId    String   @unique
  username  String?
  linkedAt  DateTime @default(now())

  @@map("telegram_links")
}

model EsmaktabSyncLog {
  id        String   @id @default(uuid())
  entity    String   // students, grades, attendance
  direction String   // import | export
  status    String   // success | failed
  message   String?
  createdAt DateTime @default(now())

  @@map("esmaktab_sync_logs")
}

// ============================================================================
//  AUDIT
// ============================================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CREATE, UPDATE, DELETE, LOGIN
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@map("audit_logs")
}

// ============================================================================
//  TASHQI PUL OQIMI — Kontragentlar (oldi-berdi daftari)
// ============================================================================

// Kontragent (oldi-berdichi/oldi-berdi shaxs yoki tashkilot)
model Counterparty {
  id        String   @id @default(uuid())
  name      String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  // Tab/kategoriya: OLDI_BERDICHI, OLDI_BERDI, TRANSFER, SOTUV, INVESTOR, INVESTITSIYA
  category  String   @default("OLDI_BERDICHI")
  // Transferlarda ko'rinadimi (filiallararo oldi-berdichi)
  filiallararo Boolean @default(false)
  note      String?
  entries   CounterpartyEntry[]
  // Investor bir nechta filialga tegishli bo'lishi mumkin (m2m)
  branchLinks CounterpartyBranch[]
  // Transfer juftligi (jo'natuvchi ↔ qabul qiluvchi)
  pairId    String?
  pair      Counterparty?  @relation("CpPair", fields: [pairId], references: [id])
  pairedBy  Counterparty[] @relation("CpPair")
  createdAt DateTime @default(now())

  @@index([category])
  @@index([branchId])
  @@index([pairId])
  @@map("counterparties")
}

// Kontragent ↔ Filial (investorlar uchun ko'p-filial bog'lanishi)
model CounterpartyBranch {
  counterpartyId String
  branchId       String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([counterpartyId, branchId])
  @@index([branchId])
  @@map("counterparty_branches")
}

// Kontragent bo'yicha kirim/chiqim yozuvi (oldi-berdi tranzaksiyasi)
model CounterpartyEntry {
  id             String       @id @default(uuid())
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  direction      String       // IN = kirim (bizga), OUT = chiqim (bizdan)
  amount         Float        // so'm ekvivalenti = somAmount + dollarAmount*dollarRate
  somAmount      Float?
  dollarAmount   Float?
  dollarRate     Float?
  sabab          String?      // Qarz berildi / Qarz olindi / ... (oldi-berdi)
  // Kassa/hisob (investitsiya, transfer)
  kassaTuri      String?      // Naqd / Karta / Bank (so'm)
  accountId      String?
  account        Account?     @relation("CpEntryAccount", fields: [accountId], references: [id])
  // Tashqi hisoblar (FlowAccount) — so'm va dollar qismi uchun alohida
  somFlowAccountId String?
  somFlowAccount   FlowAccount? @relation("EntrySomFlow", fields: [somFlowAccountId], references: [id])
  dollarKassaTuri  String?
  dollarFlowAccountId String?
  dollarFlowAccount FlowAccount? @relation("EntryDollarFlow", fields: [dollarFlowAccountId], references: [id])
  // Investitsiya kirim taqsimoti
  capex          Float?
  operation      Float?
  branchId       String?      // investitsiya filiali (scalar)
  // Investitsiya maydonlari
  periodYear     Int?
  periodMonth    Int?
  academicYear   String?
  investType     String?
  // Transfer juftligini bog'lash (jo'natuvchi/qabul qiluvchi bir transferId)
  transferPairId String?
  date           DateTime     @default(now())
  note           String?
  // Audit
  createdById    String?
  createdBy      User?        @relation("CpEntryCreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  updatedBy      User?        @relation("CpEntryUpdatedBy", fields: [updatedById], references: [id])
  // Transfer tasdig'i
  confirmedAt    DateTime?
  confirmedById  String?
  confirmedBy    User?        @relation("CpEntryConfirmedBy", fields: [confirmedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([counterpartyId])
  @@index([accountId])
  @@index([transferPairId])
  @@index([somFlowAccountId])
  @@index([dollarFlowAccountId])
  @@map("counterparty_entries")
}

// Tashqi pul oqimi hisobi (kassa) — filial + valyuta + kassa turi + foydalanuvchi
model FlowAccount {
  id        String   @id @default(uuid())
  name      String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  currency  String   @default("SOM")  // SOM | USD
  kassaTuri String   @default("Naqd") // Naqd | Karta | Bank
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  balance   Float    @default(0)
  openingBalance Float @default(0) // boshlang'ich qoldiq; balance = openingBalance + Σ(harakatlar)
  active    Boolean  @default(true)
  entrySom    CounterpartyEntry[] @relation("EntrySomFlow")
  entryDollar CounterpartyEntry[] @relation("EntryDollarFlow")
  itFrom      InternalTransfer[]  @relation("ITFrom")
  itTo        InternalTransfer[]  @relation("ITTo")
  salarySom    SalaryPayment[]    @relation("SalarySomAccount")
  salaryDollar SalaryPayment[]    @relation("SalaryDollarAccount")
  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([currency])
  @@map("flow_accounts")
}

// Ichki pul oqimi — hisoblar orasidagi o'tkazma (so'm/dollar/valyuta/pul)
model InternalTransfer {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  kind          String   // SOM | DOLLAR | VALYUTA | PUL
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  fromAccountId String?
  fromAccount   FlowAccount? @relation("ITFrom", fields: [fromAccountId], references: [id])
  toAccountId   String?
  toAccount     FlowAccount? @relation("ITTo", fields: [toAccountId], references: [id])
  kassaTuri     String?
  somAmount     Float?
  dollarAmount  Float?
  dollarRate    Float?
  loss          Float?   // yo'qotish (Pul)
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?    @relation("ITConfirmedBy", fields: [confirmedById], references: [id])
  createdById   String?
  createdBy     User?    @relation("ITCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?    @relation("ITUpdatedBy", fields: [updatedById], references: [id])
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([kind])
  @@index([date])
  @@map("internal_transfers")
}
